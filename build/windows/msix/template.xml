<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="arclights.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Arclights">
    </Installer>
    <PackageInformation
        PackageName="Arclights"
        PackageDisplayName="Arclights"
        PublisherName="CN=corruptedkey"
        PublisherDisplayName="corruptedkey"
        Version="0.1.0.0"
        PackageDescription="Arclights">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="ru.prvkey.arclights"
                Description="Arclights"
                DisplayName="Arclights"
                ExecutableName="arclights.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Arclights</DisplayName>
            <PublisherDisplayName>corruptedkey</PublisherDisplayName>
            <Description>Arknights: Endfield alternative launcher</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="arclights.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
